# Mistral AI API Key (Required)
# Obtain your key from: https://console.mistral.ai/
MISTRAL_API_KEY=your_mistral_api_key_here

# LLM Model selection (Optional, defaults to mistral-small-latest)
# Options include: mistral-small-latest, mistral-large-latest, ministral-8b-latest, ministral-14b-2512
LLM_MODEL=mistral-small-latest
